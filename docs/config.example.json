{
  "max_workers": 4,
  "towns": [
    {
      "repo": "BrokkAi/my-project",
      "branch": "main",
      "harness": "codex",
      "agent": {"model": "", "effort": ""},
      "bot_agents": {
        "review": {
          "harness": "claude",
          "agent": {"model": "", "effort": ""}
        },
        "issue": {
          "harness": "codex",
          "agent": {"model": "", "effort": ""}
        },
        "release": {
          "harness": "opencode",
          "agent": {"model": "", "effort": ""}
        }
      },
      "verify": ["go", "test", "./..."],
      "merge_policy": "bot",
      "poll_seconds": 60,
      "report_seconds": 1800,
      "max_cycles": 5,
      "funnels": [
        {
          "id": "github-ready",
          "provider": "github",
          "location": {"repository": "BrokkAi/my-project"},
          "filter": {"query": "is:issue is:open", "include_labels": "agent-ready"},
          "credentials": {"name": "github-default"},
          "transitions": {
            "working": [{"name": "labels", "parameters": {"add": "agent-in-progress"}}],
            "blocked": [{"name": "labels", "parameters": {"add": "escalated", "remove": "agent-in-progress"}}]
          },
          "enabled": true,
          "priority_policy": "source-priority"
        },
        {
          "id": "slack-intake",
          "provider": "slack",
          "location": {"channel": "C0123456789"},
          "filter": {"marker": "[town]"},
          "credentials": {"name": "slack-workspace"},
          "transitions": {
            "working": [{"name": "reaction_and_thread", "parameters": {"reaction": "eyes"}}],
            "blocked": [{"name": "reaction_and_thread", "parameters": {"reaction": "warning"}}]
          },
          "enabled": false,
          "priority_policy": "operator-explicit"
        }
      ]
    }
  ]
}
