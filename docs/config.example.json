{
  "max_workers": 4,
  "quiet_hours": [
    {"days": ["mon", "tue", "wed", "thu", "fri"], "start": "19:00", "end": "07:00"},
    {"days": ["sat", "sun"], "start": "00:00", "end": "24:00"}
  ],
  "towns": [
    {
      "repo": "BrokkAi/my-project",
      "branch": "main",
      "harness": "codex",
      "agent": {"model": "", "effort": ""},
      "bot_agents": {
        "review": {
          "harness": "claude",
          "agent": {"model": "", "effort": ""}
        },
        "issue": {
          "harness": "codex",
          "agent": {"model": "", "effort": ""}
        },
        "release": {
          "harness": "opencode",
          "agent": {"model": "", "effort": ""}
        },
        "simplifier": {
          "harness": "codex",
          "agent": {"model": "", "effort": ""}
        }
      },
      "verify": ["go", "test", "./..."],
      "merge_policy": "bot",
      "simplifier_mode": "suggest",
      "review_close_severity": "P2",
      "poll_seconds": 60,
      "report_seconds": 1800,
      "max_cycles": 5,
      "budget": {"period": "day", "max_attempts": 40, "max_agent_minutes": 600},
      "bot_policies": {
        "issue": {
          "labels": ["agent-ready"],
          "exclude_labels": ["needs-discussion"],
          "attempts": 3,
          "verify": ["go", "test", "./internal/..."]
        },
        "review": {"limit": 20, "focus": "concurrency and error handling"},
        "bug": {"focus": "the storage layer", "limit": 3},
        "simplifier": {"limit": 5},
        "release": {
          "release": {
            "daily_seconds": 86400,
            "minimum_gap_seconds": 3600,
            "quiet_seconds": 900,
            "burst": 10,
            "burst_window_seconds": 3600,
            "triage": true,
            "preflight": ["make", "preflight"],
            "verification_timeout_seconds": 600,
            "workflows": ["ci"],
            "assets": ["dist/*.tar.gz"]
          }
        }
      },
      "funnels": [
        {
          "id": "github-ready",
          "provider": "github",
          "location": {"repository": "BrokkAi/my-project"},
          "filter": {"query": "is:issue", "include_labels": "agent-ready"},
          "credentials": {"name": "github-default"},
          "transitions": {
            "working": [{"name": "labels", "parameters": {"add": "agent-in-progress"}}],
            "blocked": [{"name": "labels", "parameters": {"add": "escalated", "remove": "agent-in-progress"}}]
          },
          "enabled": true,
          "priority_policy": "source-priority"
        },
        {
          "id": "slack-intake",
          "provider": "slack",
          "location": {"channel": "C0123456789"},
          "filter": {"marker": "[town]"},
          "credentials": {"name": "slack-workspace"},
          "transitions": {
            "working": [{"name": "reaction_and_thread", "parameters": {"reaction": "eyes"}}],
            "blocked": [{"name": "reaction_and_thread", "parameters": {"reaction": "warning"}}]
          },
          "enabled": false,
          "priority_policy": "operator-explicit"
        }
      ]
    }
  ]
}
